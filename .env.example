# HRequest HRIS Environment Configuration
SECRET_KEY=django-insecure-hrequest-dev-key-change-in-production-2026
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration:
# Leave blank for local SQLite zero-config development,
# OR specify PostgreSQL connection string:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hrequest_db
DATABASE_URL=

# Firebase Admin SDK (Server-side Realtime Database)
# For Vercel, set FIREBASE_CREDENTIALS_JSON to the full JSON string from Service Accounts.
# For local dev, you can alternatively set FIREBASE_CREDENTIALS_PATH to the local .json file.
FIREBASE_DATABASE_URL=https://hr-request-7c711-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS_PATH=
